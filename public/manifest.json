{
  "manifest_version": 3,
  "name": "Bookmark Cover Flow",
  "description": "Browse Chrome bookmarks in a quiet, spatial Cover Flow.",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/kekincai/bookmark-cover-flow",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["bookmarks", "storage", "favicon"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Open Bookmark Cover Flow",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https: http: data:;"
  }
}
