{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "1.2.0",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/kekincai/bookmark-cover-flow",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["bookmarks", "storage", "favicon"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "__MSG_openExtension__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https: http: data: blob:; media-src 'self' blob:;"
  }
}
