{
  "name": "bookmark-cover-flow",
  "version": "1.0.0",
  "private": true,
  "description": "A quiet, spatial Chrome bookmark browser inspired by Cover Flow.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:extension": "npm run build && node scripts/verify-extension.mjs",
    "capture:demo": "npm run build && node scripts/capture-demo.mjs",
    "package:extension": "npm run build && cd dist && zip -FSr ../bookmark-cover-flow.zip ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
